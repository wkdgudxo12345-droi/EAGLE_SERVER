thresholds:
  fit_a: 82
  fit_b: 68
  reject_below: 68
  min_reality: 55
  min_hr: 60
  min_ccstm: 68

weights:
  ccstm:
    role_match: 35
    experience: 25
    no_car: 15
    accommodation: 10
    visa: 10
    freshness: 5
  hr:
    direct_experience: 30
    transferable_ops: 25
    shift_reliability: 15
    language: 10
    location_commitment: 10
    requirements: 10
  reality:
    live_link: 25
    individual_job_url: 20
    no_hard_gate: 25
    accommodation: 10
    evidence_quality: 10
    freshness: 10

hard_reject_terms:
  - unrestricted drivers licence
  - unrestricted driver's licence
  - own reliable vehicle
  - must have own transport
  - australian citizenship required
  - permanent resident only
  - minimum 3 years australian experience

preferred_terms:
  - staff accommodation
  - accommodation provided
  - live on site
  - no experience required
  - training provided
  - working holiday
  - night shift
  - roster
  - steward
  - guest service
  - reservations
  - site administrator
  - mobilisation

search_url_patterns:
  - '/jobs?'
  - 'seek.com.au/jobs'
  - 'indeed.com/jobs'
  - 'linkedin.com/jobs/search'
