name: Eagle Job Pipeline
on:
  workflow_dispatch:
    inputs:
      apply_changes:
        description: 'Write scores and archive C/Reject rows'
        required: true
        default: false
        type: boolean
  schedule:
    - cron: '17 1,7,13 * * *'
      timezone: 'Asia/Kuala_Lumpur'

permissions:
  contents: read

concurrency:
  group: eagle-job-pipeline
  cancel-in-progress: false

jobs:
  evaluate:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: 'pip'
      - run: pip install -r requirements.txt
      - name: Run all rows through CCSTM → HR → RAG → Red Team
        env:
          NOTION_TOKEN: ${{ secrets.NOTION_TOKEN }}
          NOTION_DATABASE_ID: ${{ secrets.NOTION_DATABASE_ID }}
          APPLY_CHANGES: ${{ github.event_name == 'workflow_dispatch' && inputs.apply_changes || 'true' }}
          ARCHIVE_REJECTED: 'true'
        run: python -m eagle.main
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: eagle-report-${{ github.run_number }}
          path: output/report.json
          retention-days: 7
