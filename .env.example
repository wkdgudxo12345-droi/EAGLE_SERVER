NOTION_TOKEN=secret_xxxxxxxxx

# Prefer the exact data source ID. If omitted, Eagle can discover a single data
# source from NOTION_DATABASE_ID but refuses to guess when multiple sources exist.
NOTION_DATA_SOURCE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_VERSION=2026-03-11
STRICT_SCHEMA=true

# Existing Stage 1/2/3/Final rows are report-only in V4.
APPLY_CHANGES=false
ARCHIVE_REJECTED=false
URL_CHECK_ENABLED=true
URL_CHECK_TIMEOUT_SECONDS=12

EAGLE_EVIDENCE_FILE=data/policy_evidence.json
RAG_USE_LLM=false
REQUIRE_LLM_RAG=false
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

RESUME_ENABLED=true
STATE_DIR=state
OUTPUT_DIR=output
SOFT_DEADLINE_SECONDS=3000
EAGLE_RUN_KEY=local
EAGLE_CODE_SHA=local

# MAX_ROWS=10
# EAGLE_CONFIG=config/scoring.yml
